{
  "name": "jupyterlite-obsidian-markdown",
  "version": "1.0.0",
  "description": "Obsidian-like interactive markdown editor for JupyterLite with LaTeX math menu and table builder",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "jupyterlite",
    "jupyterlab-extension",
    "obsidian",
    "markdown",
    "katex",
    "latex"
  ],
  "license": "BSD-3-Clause",
  "author": "Stefan Merkfuss",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*.{d.ts,eot,gif,html,jpg,js,js.map,json,png,svg,woff2,ttf}",
    "style/**/*.{css,js,eot,gif,html,jpg,json,png,svg,woff2,ttf}"
  ],
  "jupyterlab": {
    "extension": true,
    "outputDir": "jupyterlite_obsidian_markdown/labextension"
  },
  "scripts": {
    "build": "jlpm build:lib && jlpm build:labextension:dev",
    "build:prod": "jlpm clean && jlpm build:lib:prod && jlpm build:labextension",
    "watch": "run-p watch:src watch:labextension"
  },
  "dependencies": {
    "@jupyterlab/application": "^4.0.0",
    "@jupyterlab/notebook": "^4.0.0",
    "@jupyterlab/cells": "^4.0.0",
    "katex": "^0.16.11"
  },
  "devDependencies": {
    "@jupyterlab/builder": "^4.0.0",
    "rimraf": "^5.0.0",
    "typescript": "~5.0.0"
  }
}